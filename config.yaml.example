######################################################################
# Miyoka Config file
#
# Do NOT share it with someone else!
######################################################################

game:
  name: sf6
  window:
    name: Street Fighter 6
  players:
    # `name`: Name of the player displayed in replay viewer.
    # `id`: Identifier of the player in the game. Replay Uploader crawls replays associated with the ID in the game.
    # `pattern`: Pattern of the player name in the game. This is used to filter the replay dataset for each player.
    - name: "Player1"
      id: "<your-player-id>"
      pattern: "Player1"
    # 複数プレイヤーを登録する場合は以下のように追加
    # - name: "Player2"
    #   id: "<player2-id>"
    #   pattern: "Player2"
  # Alternatively, you can specify Replay IDs to be recorded.
  # In this case, `players` above will be ignored.
  # replay_ids:
  #  - ABCDXQPDH
  #  - CBADXQPDH
  extra:
    # Language setting for template matching. Supported values: en, jp
    original_language: en
    original_quality: Normal
    original_display_mode: Windowed
  # Game launch settings
  launch:
    # Launch method: "direct" (default) or "steam"
    method: direct
    # Path to game executable (for direct launch)
    # Windows example: C:\Program Files (x86)\Steam\steamapps\common\Street Fighter 6\StreetFighter6.exe
    # Linux example: /home/user/.steam/steam/steamapps/common/Street Fighter 6/StreetFighter6.exe
    exe_path: ""
    # Steam App ID (for Steam launch)
    steam_app_id: "1364780"
    # Time to wait for game to start (seconds)
    startup_wait_seconds: 60

replay_recorder:
  # How many replays to be recorded per run.
  max_replays_per_run: 100
  # Stop recording after the number of duplicate replays.
  stop_after_duplicate_replays: 3
  # If true, skip recording the replay. This is useful to extract only replay summaries.
  skip_recording: false
  # Directory to save the recorded replays. Supports absolute or relative paths.
  # Actual files are placed under <local_file_storage_dir>/<player_id>/.
  local_file_storage_dir: replays
  # If true, each round is recorded separately. e.g. If a match had three rounds, there will be three videos.
  separate_round: false
  # If true, exit the game when replay upload is done.
  exit_to_desktop: true

# OBS Studio settings
obs:
  # Path to OBS executable (optional, auto-detected if not set)
  # Windows: C:\Program Files\obs-studio\bin\64bit\obs64.exe
  # Linux: /usr/bin/obs or flatpak run com.obsproject.Studio
  exe_path: ""
  # WebSocket server settings (must match OBS WebSocket settings)
  websocket:
    host: localhost
    port: 4455
    # Password (leave empty for no password)
    password: ""

# Logging settings
log:
  name: miyoka
  dir_path: logs
  file_name: miyoka.log
  standard_output: true
  file_output: true
  clear_everytime: false
  # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: INFO
  # Log rotation settings
  rotation:
    # Maximum size of each log file in bytes (default: 10MB)
    max_bytes: 10485760
    # Number of backup files to keep
    backup_count: 5

# Discord notification settings
discord:
  # Enable Discord notifications
  enabled: false
  # Discord Webhook URL
  webhook_url: ""
  # Minimum log level to send notifications: DEBUG, INFO, WARNING, ERROR, CRITICAL
  min_level: WARNING
  # Mention @everyone on ERROR and above
  mention_on_error: false

# Scheduler settings (Linux only, uses systemd timer)
scheduler:
  # Interval between recordings in hours
  interval_hours: 12
